# AN758x PonWrt 单机型「精简」配置（diffconfig）—— 使用前必须 make defconfig 展开
# profile      : bell_xg-140g-tf   （显示名 / 产物名，Actions 下拉里的这一项）
# 底层机型     : Nokia XG-040G-TF (UBI) —— 设备符号 nokia_xg-040g-tf-ubi
# 实际硬件     : 贝尔 XG-140G-TF（AN7581），与 XG-040G-TF 同参考设计
# SoC          : AN7581
# 硬件要点     : TF 面板，无 WiFi、无 USB（DTS 已 disabled）
# 光器件       : Airoha EN7572
# 网口 PHY     : EN8811H（2.5G）
# 校准/身份数据: bosa, ri
#
# 源码         : pbs05/ponwrt（ImmortalWrt + Airoha AN758x PON），分支 master
# 内核         : 6.18    包管理：apk + 全量签名
#
# 本配置的取向：
#   只保留「PPPoE 拨号能正常上网」所必需的系统包 +
#   OpenClash（来源 vernesong/OpenClash，由 diy-part1.sh 拉取 dev 分支）+
#   网络唤醒（luci-app-wol / etherwake）。
#   其余插件、WiFi 栈、USB 存储栈、IPTV、诊断工具、VPN 内核模块全部显式关闭。
#
# 想临时加回某个功能：把对应 "# CONFIG_PACKAGE_xxx is not set" 删掉，
# 再在 diy-part2.sh 的 LEAN 分支里补一行 =y（或直接写在本文件末尾）。
#=========================================================================

CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_LINUX_6_18=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y

#=========================================================================
# DEVICES —— 底层设备符号（workflow 的 Apply device profile 会按
# DEVICE_SYMBOL 重写这一段，本地直接 make 时用的就是它）
#=========================================================================
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-tf-ubi=y
CONFIG_TARGET_DEVICE_PACKAGES_airoha_an7581_DEVICE_nokia_xg-040g-tf-ubi=""

#=========================================================================
# apk 包管理（ImmortalWrt 24.10+ 默认，替代 opkg）+ 全量签名
#=========================================================================
CONFIG_USE_APK=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGNATURE_CHECK=y
CONFIG_DOWNLOAD_CHECK_CERTIFICATE=y
CONFIG_SIGN_EACH_PACKAGE=y
CONFIG_SIGN_FIRMWARE=y

#=========================================================================
# 编译与内核基础选项
#=========================================================================
CONFIG_DEVEL=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_PKG_FORTIFY_SOURCE_1=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_PKG_DT_RELR=y
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_REGULAR=y
CONFIG_PKG_CC_STACKPROTECTOR_REGULAR=y
CONFIG_KERNEL_CC_STACKPROTECTOR_REGULAR=y
CONFIG_KERNEL_STACKPROTECTOR=y
CONFIG_USE_SSTRIP=y
CONFIG_SSTRIP_DISCARD_TRAILING_ZEROES=y
CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_MOLD=y
CONFIG_IPV6=y
CONFIG_KERNEL_IPV6=y

#=========================================================================
# 1. PON 光口链路 —— 缺一个就拨不上号
#=========================================================================
CONFIG_PACKAGE_kmod-airoha-xpon=y                  # PON MAC：MAC/TC 层
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y          # 光前端抽象层：BOSA/DDM
CONFIG_PACKAGE_airoha-pond=y                       # OMCI+OAM 代理：ONU 注册、LOID 认证、GEM 协商
CONFIG_PACKAGE_airoha-ponctl=y                     # 线路配置与状态
CONFIG_PACKAGE_kmod-airoha-en7572=y                # EN7572 光前端驱动 ★本机型
CONFIG_PACKAGE_luci-app-pon=y                      # PON 界面：SN / MAC / LOID / Vendor ID

#=========================================================================
# 2. 硬件卸载 / 2.5G PHY / 引导
#=========================================================================
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y        # EN7581 NPU(RISC-V) 固件 ★硬件卸载前提
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y           # EN8811H 2.5G PHY
CONFIG_PACKAGE_airoha-en8811h-firmware=y           # EN8811H MD32 固件
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y          # 复位键
CONFIG_PACKAGE_kmod-leds-gpio=y                    # 面板 LED
CONFIG_PACKAGE_trusted-firmware-a-an7581-bl2=y     # TF-A BL2
CONFIG_PACKAGE_trusted-firmware-a-an7581-bl31=y    # TF-A BL31

#=========================================================================
# 3. 拨号（PPPoE / DHCP）+ IPv6
#=========================================================================
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-slhc=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

#=========================================================================
# 4. 防火墙 / NAT / 转发（nftables，不引 iptables）
#     kmod-nft-tproxy / kmod-nft-socket 是 OpenClash 透明代理的硬依赖
#=========================================================================
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-fullcone=y                 # 全锥形 NAT（游戏/PT 友好）
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y                  # flow offload -> PPE 硬件转发
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nf-log=y
CONFIG_PACKAGE_kmod-nf-log6=y
CONFIG_PACKAGE_kmod-nf-reject=y
CONFIG_PACKAGE_kmod-nf-reject6=y
CONFIG_PACKAGE_kmod-nfnetlink=y

#=========================================================================
# 5. DNS / DHCP
#=========================================================================
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y               # OpenClash 的 DNS 分流走 nftset，必须开
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y

#=========================================================================
# 6. LuCI 基础框架（只留管理必需品，不装额外 app / 主题包）
#=========================================================================
CONFIG_LUCI_LANG_zh_Hans=y                         # 简体中文总开关（diy-part3.sh 再裁翻译包）
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y          # 「软件包」页：留着方便 apk add
CONFIG_PACKAGE_luci-lib-nixio_openssl=y
CONFIG_PACKAGE_luci-lib-uqr=y

#=========================================================================
# 7. OpenClash —— 来源 https://github.com/vernesong/OpenClash
#    diy-part1.sh 会 rm 掉 feeds 自带的 luci-app-openclash，再 clone dev 分支，
#    所以这里选中的就是 vernesong 的原版。
#    依赖自动拉入：ruby / ruby-yaml / curl / ca-bundle / ip-full /
#                  kmod-tun / unzip / dnsmasq-full / luci-compat /
#                  kmod-inet-diag / kmod-nft-tproxy
#    ⚠ 编译含 ruby，冷编译会多花 10~20 分钟。
#=========================================================================
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
# 中文翻译已由 OpenClash 的 Makefile 在 Build/Prepare 里 po2lmo 打进本包，
# 不存在独立的 luci-i18n-openclash-zh-cn，别在这里写。

#=========================================================================
# 8. 网络唤醒（Wake-on-LAN）
#    luci-app-wol 来自 immortalwrt/luci，依赖 etherwake，不需要额外 feed。
#=========================================================================
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y

#=========================================================================
# 9. 系统基础与固件工具（拨号/升级必需）
#=========================================================================
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_procd-seccomp=y
CONFIG_PACKAGE_procd-ujail=y
CONFIG_PACKAGE_ubox=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_openwrt-keyring=y
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_autocore=y                          # 概览页状态/温度（基座默认）
CONFIG_PACKAGE_getrandom=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_fitblk=y                            # .itb(FIT) 升级
CONFIG_PACKAGE_fwtool=y
CONFIG_PACKAGE_usign=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_kmod-tcp-bbr=y                      # BBR 拥塞控制（纯内核模块，无 UI）

#=========================================================================
# 10. WiFi —— 本机型无无线，整条栈关掉（省 3~5MB）
#=========================================================================
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_kmod-mt76-core is not set
# CONFIG_PACKAGE_kmod-mt76-connac is not set
# CONFIG_PACKAGE_kmod-mt7915e is not set
# CONFIG_MODULE_DEFAULT_kmod-mt7915e is not set
# CONFIG_PACKAGE_kmod-mt7916-firmware is not set
# CONFIG_MODULE_DEFAULT_kmod-mt7916-firmware is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_MODULE_DEFAULT_wpad-openssl is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_wireless-regdb is not set
# CONFIG_PACKAGE_iw is not set
# CONFIG_PACKAGE_wifi-scripts is not set
# CONFIG_PACKAGE_MAC80211_DEBUGFS is not set
# CONFIG_PACKAGE_MAC80211_MESH is not set
# CONFIG_PACKAGE_znxt-zn515-mt7916-eeprom is not set
# CONFIG_MODULE_DEFAULT_znxt-zn515-mt7916-eeprom is not set
# CONFIG_PACKAGE_ucode-mod-nl80211 is not set

#=========================================================================
# 11. USB / 外置存储 —— TF 机型 DTS 里 usb0/usb1 已 disabled
#     （要用 U 盘的话把这一整段删掉，并把 diy-part2.sh 的 ENABLE_USB_OPT_MOUNT 打开）
#=========================================================================
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-common is not set
# CONFIG_PACKAGE_kmod-usb-xhci-hcd is not set
# CONFIG_PACKAGE_kmod-usb-xhci-mtk is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_MODULE_DEFAULT_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_MODULE_DEFAULT_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-storage-uas is not set
# CONFIG_MODULE_DEFAULT_kmod-usb-storage-uas is not set
# CONFIG_PACKAGE_kmod-usb-ledtrig-usbport is not set
# CONFIG_MODULE_DEFAULT_kmod-usb-ledtrig-usbport is not set
# CONFIG_PACKAGE_kmod-scsi-core is not set
# CONFIG_PACKAGE_kmod-regulator-userspace-consumer is not set
# CONFIG_MODULE_DEFAULT_kmod-regulator-userspace-consumer is not set
# CONFIG_PACKAGE_block-mount is not set
# CONFIG_MODULE_DEFAULT_block-mount is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_MODULE_DEFAULT_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-exfat is not set
# CONFIG_MODULE_DEFAULT_kmod-fs-exfat is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set
# CONFIG_MODULE_DEFAULT_kmod-fs-vfat is not set
# CONFIG_PACKAGE_kmod-nls-base is not set
# CONFIG_PACKAGE_kmod-nls-cp437 is not set
# CONFIG_PACKAGE_kmod-nls-iso8859-1 is not set
# CONFIG_PACKAGE_kmod-nls-utf8 is not set

#=========================================================================
# 12. VPN / 隧道 / 其他内核模块 —— 拨号与 OpenClash 都用不到
#     （注意：kmod-tun 给 OpenClash 留着，见第 7 段，别一起关掉）
#=========================================================================
# CONFIG_PACKAGE_kmod-wireguard is not set
# CONFIG_PACKAGE_kmod-ovpn-backports is not set
# CONFIG_PACKAGE_kmod-mppe is not set
# CONFIG_PACKAGE_kmod-udptunnel4 is not set
# CONFIG_PACKAGE_kmod-udptunnel6 is not set
# CONFIG_PACKAGE_kmod-macvlan is not set
# CONFIG_PACKAGE_kmod-sched-cake is not set
# CONFIG_PACKAGE_kmod-phy-maxlinear is not set
# CONFIG_MODULE_DEFAULT_kmod-phy-maxlinear is not set
# CONFIG_PACKAGE_kmod-phy-realtek is not set
# CONFIG_MODULE_DEFAULT_kmod-phy-realtek is not set
# CONFIG_PACKAGE_rtl826x-firmware is not set
# CONFIG_MODULE_DEFAULT_rtl826x-firmware is not set
# CONFIG_PACKAGE_kmod-airoha-paged-bosa is not set
# CONFIG_MODULE_DEFAULT_kmod-airoha-paged-bosa is not set

#=========================================================================
# 13. 插件 / 应用 / 诊断工具 —— 全部精简掉
#     IPTV、PON 状态页、NAT 类型选择、NPU 状态页、抓包、测速、i2c、ethtool
#=========================================================================
# CONFIG_PACKAGE_luci-app-iptv is not set
# CONFIG_MODULE_DEFAULT_luci-app-iptv is not set
# CONFIG_PACKAGE_luci-i18n-iptv-zh-cn is not set
# CONFIG_MODULE_DEFAULT_luci-i18n-iptv-zh-cn is not set
# CONFIG_PACKAGE_luci-app-rtp2httpd is not set
# CONFIG_PACKAGE_rtp2httpd is not set
# CONFIG_PACKAGE_luci-app-pon-status is not set
# CONFIG_PACKAGE_luci-app-natmode is not set
# CONFIG_PACKAGE_luci-app-airoha-npu is not set
# CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn is not set
# CONFIG_PACKAGE_airoha-pon-debug is not set
# CONFIG_PACKAGE_tcpdump is not set
# CONFIG_PACKAGE_iperf3 is not set
# CONFIG_PACKAGE_libiperf3 is not set
# CONFIG_PACKAGE_i2c-tools is not set
# CONFIG_MODULE_DEFAULT_i2c-tools is not set
